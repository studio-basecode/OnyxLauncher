// PojavLauncher JRE Sandbox
// DO NOT EDIT THIS FILE WITHOUT KNOWLEDGE!
// This file is important to protect you against viruses/malwares that could be come from unknown Java Programs (run on mod install) or a mod.

priority "grant";

grant {
    permission java.io.FilePermission "./-", "read, write, delete";
    permission java.io.FilePermission "${java.io.tmpdir}/-", "read, write, delete";
    permission java.io.FilePermission "${user.home}/-", "read, write, delete";
    // Required by Forge/NeoForge FART (ForgeAutoRenamingTool) which uses ForkJoinPool
    // and calls getDeclaredMethods() on classes during the remapping process.
    permission java.lang.RuntimePermission "accessDeclaredMembers";
    // Required for FART and other tools that use reflection to access class members
    permission java.lang.reflect.ReflectPermission "suppressAccessChecks";
    // Required for multi-threaded class processing by Forge installer processors
    permission java.lang.RuntimePermission "modifyThreadGroup";
    permission java.lang.RuntimePermission "createClassLoader";
};

deny {
    permission java.io.FilePermission "${onyx.path.private.account}/-", "read, write, delete";
    permission java.io.FilePermission "<<ALL FILES>>", "write, delete, execute";
};

